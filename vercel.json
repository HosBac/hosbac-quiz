{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "server/**"
    },
    "api/pvp/match.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "server/**"
    },
    "api/quiz/status.js": {
      "maxDuration": 20,
      "memory": 512,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/quiz",
      "destination": "/index.html"
    },
    {
      "source": "/api/pvp/match",
      "destination": "/api/pvp/match.js"
    },
    {
      "source": "/api/quiz/status",
      "destination": "/api/quiz/status.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex,nofollow"
        }
      ]
    }
  ]
}
